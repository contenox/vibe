PROJECT_ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
include $(PROJECT_ROOT)mk/llama-flags.mk

LLAMA_CPP_SRC ?= $(LLAMA_CPP_REF_DIR)
LLAMA_CPP_BUILD_ROOT ?= $(PROJECT_ROOT).build/llamacpp
LLAMA_CPP_BUILD_TYPE ?= Release
LLAMA_CPP_BUILD_JOBS ?= 4
LLAMA_CPP_CMAKE ?= cmake
LLAMA_CPP_BUILD_DIR ?= $(LLAMA_CPP_BUILD_ROOT)/$(LLAMA_RUNTIME_PROFILE)
LLAMA_RUNTIME_REBUILD ?=

# Enable the CUDA ggml plugin when nvcc is available.
LLAMA_HAVE_NVCC := $(shell command -v nvcc >/dev/null 2>&1 && echo 1)
LLAMA_CUDA := $(if $(LLAMA_HAVE_NVCC),ON,OFF)

# Enable the HIP ggml plugin when hipcc is available.
LLAMA_HAVE_HIPCC := $(shell command -v hipcc >/dev/null 2>&1 && echo 1)
LLAMA_HIP := $(if $(LLAMA_HAVE_HIPCC),ON,OFF)

# Runtime ABI stamp for generated llama.cpp libraries.
# dl-v2: libmtmd (multimodal projector support) joined the runtime link set.
LLAMA_RUNTIME_ABI := dl-v2

# In-tree tiny model that gates the llamasession system tests; without it
# every real inference test silently skips and test-session is a false green.
CONTENOX_LLAMA_TINY_GGUF ?= $(LLAMA_RUNTIME_ROOT)/models/fastthink-0.5b-tiny-q2_k.gguf
CONTENOX_LLAMA_TINY_GGUF_URL ?= https://huggingface.co/Hjgugugjhuhjggg/FastThink-0.5B-Tiny-Q2_K-GGUF/resolve/main/fastthink-0.5b-tiny-q2_k.gguf

# In-tree vision model (two-file layout: model.gguf + mmproj.gguf, the same
# convention modeld/modelstore resolves) gating the vision system tests. Same
# hard-error-if-missing philosophy as the tiny model.
CONTENOX_LLAMA_VLM_DIR ?= $(LLAMA_RUNTIME_ROOT)/models/smolvlm2-2.2b-instruct
CONTENOX_LLAMA_VLM_GGUF ?= $(CONTENOX_LLAMA_VLM_DIR)/model.gguf
CONTENOX_LLAMA_VLM_MMPROJ ?= $(CONTENOX_LLAMA_VLM_DIR)/mmproj.gguf
CONTENOX_LLAMA_VLM_GGUF_URL ?= https://huggingface.co/ggml-org/SmolVLM2-2.2B-Instruct-GGUF/resolve/main/SmolVLM2-2.2B-Instruct-Q4_K_M.gguf
CONTENOX_LLAMA_VLM_MMPROJ_URL ?= https://huggingface.co/ggml-org/SmolVLM2-2.2B-Instruct-GGUF/resolve/main/mmproj-SmolVLM2-2.2B-Instruct-Q8_0.gguf

# Build ggml CPU/CUDA backends as runtime-loaded plugins.
# CPU variants are built portably instead of using -march=native.
LLAMA_CPP_COMMON_CMAKE_FLAGS = \
	-S "$(LLAMA_CPP_SRC)" \
	-B "$(LLAMA_CPP_BUILD_DIR)" \
	-DCMAKE_BUILD_TYPE="$(LLAMA_CPP_BUILD_TYPE)" \
	-DCMAKE_INSTALL_PREFIX="$(LLAMA_RUNTIME_DIR)" \
	-DBUILD_SHARED_LIBS=ON \
	-DGGML_BACKEND_DL=ON \
	-DGGML_CPU_ALL_VARIANTS=ON \
	-DGGML_NATIVE=OFF \
	-DGGML_HIP=$(LLAMA_HIP) \
	-DLLAMA_BUILD_TESTS=OFF \
	-DLLAMA_BUILD_TOOLS=OFF \
	-DLLAMA_BUILD_MTMD=ON \
	-DMTMD_VIDEO=OFF \
	-DLLAMA_BUILD_EXAMPLES=OFF \
	-DLLAMA_BUILD_SERVER=OFF \
	-DLLAMA_BUILD_APP=OFF \
	-DLLAMA_BUILD_COMMON=ON \
	-DLLAMA_CURL=OFF \
	-DCMAKE_INSTALL_LIBDIR=lib

# Extra flags for difficult Windows/MinGW environments (cpp-httplib CreateFile2 etc.)
# These are safe to pass; they only affect the Windows build.
ifeq ($(LLAMA_TARGET_OS),windows)
LLAMA_CPP_COMMON_CMAKE_FLAGS += \
	-DCMAKE_CXX_FLAGS="-D_WIN32_WINNT=0x0A00 -DWINVER=0x0A00 -D_CRT_SECURE_NO_WARNINGS" \
	-DCMAKE_C_FLAGS="-D_WIN32_WINNT=0x0A00 -DWINVER=0x0A00 -D_CRT_SECURE_NO_WARNINGS"
endif

# OS-specific expectations for the installed layout.
# On Windows/MinGW cmake install typically lands DLLs in bin/; we copy them
# into lib/ so the rest of the tree (bundlers, CGO -L, package steps) can
# find them uniformly.
LLAMA_TARGET_OS ?= $(shell go env GOOS 2>/dev/null)
ifeq ($(LLAMA_TARGET_OS),windows)
LLAMA_DSO_EXT := dll
LLAMA_DSO_GLOB := *.dll
LLAMA_DSO_NAME_GLOB := *$(LLAMA_DSO_EXT)
LLAMA_EXPECT_CORE := llama.dll
LLAMA_EXPECT_COMMON := llama-common.dll
LLAMA_PLUGIN_GLOB := ggml-*.dll
else
LLAMA_DSO_EXT := so
LLAMA_DSO_GLOB := *.so*
LLAMA_DSO_NAME_GLOB := *$(LLAMA_DSO_EXT)
LLAMA_EXPECT_CORE := libllama.so
LLAMA_EXPECT_COMMON := libllama-common.so
LLAMA_PLUGIN_GLOB := libggml-*.so
endif

.PHONY: help deps-ref deps-tiny-model deps-vlm-model runtime test test-shim test-session test-session-vision clean

help:
	@echo "runtime         build/install the pinned direct llama.cpp runtime; CUDA is"
	@echo "                included automatically when nvcc is present, else CPU-only"
	@echo "                set LLAMA_RUNTIME_REBUILD=1 to force a clean runtime rebuild"
	@echo "test            build the runtime and test direct llama.cpp packages"
	@echo "test-shim       build the runtime and test internal/modeld/llama/llamacppshim"
	@echo "test-session    build the runtime and test internal/modeld/llama/llamasession"
	@echo "test-session-vision  run the real-model vision (mtmd) system tests"
	@echo "deps-ref        fetch upstream llama.cpp reference source"
	@echo "deps-tiny-model fetch the tiny test model gating test-session"
	@echo "deps-vlm-model  fetch the vision test model gating test-session-vision"
	@echo "clean           remove direct llama.cpp build/install outputs"

deps-tiny-model:
	@test -f "$(CONTENOX_LLAMA_TINY_GGUF)" && { echo "tiny test model present -> $(CONTENOX_LLAMA_TINY_GGUF)"; exit 0; }; \
		mkdir -p "$(dir $(CONTENOX_LLAMA_TINY_GGUF))"; \
		echo "fetching tiny test model -> $(CONTENOX_LLAMA_TINY_GGUF)"; \
		curl -fL --retry 3 -o "$(CONTENOX_LLAMA_TINY_GGUF).part" "$(CONTENOX_LLAMA_TINY_GGUF_URL)"; \
		mv "$(CONTENOX_LLAMA_TINY_GGUF).part" "$(CONTENOX_LLAMA_TINY_GGUF)"

deps-vlm-model:
	@mkdir -p "$(CONTENOX_LLAMA_VLM_DIR)"; \
		if [ ! -f "$(CONTENOX_LLAMA_VLM_GGUF)" ]; then \
			echo "fetching vision test model -> $(CONTENOX_LLAMA_VLM_GGUF)"; \
			curl -fL --retry 3 -o "$(CONTENOX_LLAMA_VLM_GGUF).part" "$(CONTENOX_LLAMA_VLM_GGUF_URL)"; \
			mv "$(CONTENOX_LLAMA_VLM_GGUF).part" "$(CONTENOX_LLAMA_VLM_GGUF)"; \
		else echo "vision test model present -> $(CONTENOX_LLAMA_VLM_GGUF)"; fi; \
		if [ ! -f "$(CONTENOX_LLAMA_VLM_MMPROJ)" ]; then \
			echo "fetching vision test projector -> $(CONTENOX_LLAMA_VLM_MMPROJ)"; \
			curl -fL --retry 3 -o "$(CONTENOX_LLAMA_VLM_MMPROJ).part" "$(CONTENOX_LLAMA_VLM_MMPROJ_URL)"; \
			mv "$(CONTENOX_LLAMA_VLM_MMPROJ).part" "$(CONTENOX_LLAMA_VLM_MMPROJ)"; \
		else echo "vision test projector present -> $(CONTENOX_LLAMA_VLM_MMPROJ)"; fi

deps-ref:
	@mkdir -p "$(dir $(LLAMA_CPP_REF_DIR))"
	@if [ -d "$(LLAMA_CPP_REF_DIR)/.git" ] && [ "$$(git -C "$(LLAMA_CPP_REF_DIR)" rev-parse HEAD 2>/dev/null)" = "$(LLAMA_CPP_COMMIT)" ]; then \
		git -C "$(LLAMA_CPP_REF_DIR)" log -1 --oneline; \
	elif [ -d "$(LLAMA_CPP_REF_DIR)/.git" ]; then \
		git -C "$(LLAMA_CPP_REF_DIR)" fetch --depth 1 origin "$(LLAMA_CPP_COMMIT)"; \
		git -C "$(LLAMA_CPP_REF_DIR)" checkout --detach "$(LLAMA_CPP_COMMIT)" >/dev/null; \
		git -C "$(LLAMA_CPP_REF_DIR)" log -1 --oneline; \
	else \
		git clone --no-checkout "$(LLAMA_CPP_REF_REPO)" "$(LLAMA_CPP_REF_DIR)"; \
		git -C "$(LLAMA_CPP_REF_DIR)" fetch --depth 1 origin "$(LLAMA_CPP_COMMIT)"; \
		git -C "$(LLAMA_CPP_REF_DIR)" checkout --detach "$(LLAMA_CPP_COMMIT)" >/dev/null; \
		git -C "$(LLAMA_CPP_REF_DIR)" log -1 --oneline; \
	fi

runtime: LLAMA_RUNTIME_DIR := $(LLAMA_RUNTIME_ROOT)/local
runtime: LLAMA_CPP_BUILD_DIR := $(LLAMA_CPP_BUILD_ROOT)/local
runtime: deps-ref
	@command -v "$(LLAMA_CPP_CMAKE)" >/dev/null 2>&1 || { echo "missing cmake; install CMake before building direct llama.cpp"; exit 1; }
	@test -f "$(LLAMA_CPP_SRC)/CMakeLists.txt" || { echo "missing llama.cpp source at $(LLAMA_CPP_SRC); run: make deps-llamacpp-ref"; exit 1; }
	@if [ "$(LLAMA_RUNTIME_REBUILD)" != "1" ] && \
		[ -f "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp" ] && \
		grep -qx 'commit=$(LLAMA_CPP_COMMIT)' "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp" && \
		grep -qx 'build_type=$(LLAMA_CPP_BUILD_TYPE)' "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp" && \
		grep -qx 'runtime_abi=$(LLAMA_RUNTIME_ABI)' "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp" && \
		grep -qx 'cuda=$(LLAMA_CUDA)' "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp" && \
		grep -qx 'hip=$(LLAMA_HIP)' "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp" && \
		( ls "$(LLAMA_RUNTIME_DIR)"/lib/*llama*.$(LLAMA_DSO_EXT) >/dev/null 2>&1 || ls "$(LLAMA_RUNTIME_DIR)"/lib/*llama*.dll >/dev/null 2>&1 || ls "$(LLAMA_RUNTIME_DIR)"/lib/libllama*.so* >/dev/null 2>&1 ); then \
		echo "direct llama.cpp runtime already present (cuda=$(LLAMA_CUDA)) -> $(LLAMA_RUNTIME_DIR)"; \
		find "$(LLAMA_RUNTIME_DIR)/lib" -maxdepth 1 \( -type f -o -type l \) -name '$(LLAMA_DSO_GLOB)' -printf '  %f\n' 2>/dev/null | sort || ls -1 "$(LLAMA_RUNTIME_DIR)/lib/"$(LLAMA_DSO_NAME_GLOB) 2>/dev/null | sort || true; \
	else \
		rm -rf "$(LLAMA_CPP_BUILD_DIR)" "$(LLAMA_RUNTIME_DIR)"; \
		$(LLAMA_CPP_CMAKE) $(LLAMA_CPP_COMMON_CMAKE_FLAGS) -DGGML_CUDA=$(LLAMA_CUDA) -DGGML_HIP=$(LLAMA_HIP); \
		$(LLAMA_CPP_CMAKE) --build "$(LLAMA_CPP_BUILD_DIR)" --target install -j $(LLAMA_CPP_BUILD_JOBS); \
		libdir="$(LLAMA_RUNTIME_DIR)/lib"; \
		mkdir -p "$$libdir"; \
		if [ "$(LLAMA_TARGET_OS)" = "windows" ]; then \
			echo "post-processing windows DLL layout into $$libdir"; \
			for f in "$(LLAMA_RUNTIME_DIR)"/bin/*llama*.dll "$(LLAMA_RUNTIME_DIR)"/bin/ggml*.dll "$(LLAMA_RUNTIME_DIR)"/bin/*mtmd*.dll; do \
				[ -f "$$f" ] && cp -a "$$f" "$$libdir/" || true; \
			done; \
			# Also handle any lib-prefixed variants that may have been produced \
			for f in "$(LLAMA_RUNTIME_DIR)"/bin/libllama*.dll "$(LLAMA_RUNTIME_DIR)"/bin/libggml*.dll "$(LLAMA_RUNTIME_DIR)"/bin/libmtmd*.dll; do \
				[ -f "$$f" ] && cp -a "$$f" "$$libdir/" || true; \
			done; \
			ls "$$libdir"/*llama*.dll >/dev/null 2>&1 || ls "$$libdir"/llama.dll >/dev/null 2>&1 || { echo "direct llama.cpp runtime missing llama DLLs in $$libdir after copy from bin/"; exit 1; }; \
			ls "$$libdir"/ggml-cpu*.dll >/dev/null 2>&1 || { echo "direct llama.cpp runtime missing ggml-cpu DLL plugins (GGML_BACKEND_DL) in $$libdir"; exit 1; }; \
			{ [ "$(LLAMA_CUDA)" != "ON" ] || ls "$$libdir"/ggml-cuda*.dll >/dev/null 2>&1 || { echo "CUDA requested but no ggml-cuda DLL"; exit 1; }; }; \
		else \
			test -f "$$libdir/libllama-common.so" || { echo "direct llama.cpp runtime missing libllama-common.so in $$libdir (install layout changed?)"; exit 1; }; \
			test -f "$$libdir/libllama.so" || { echo "direct llama.cpp runtime missing libllama.so in $$libdir"; exit 1; }; \
			test -e "$$libdir/libmtmd.so" || { echo "direct llama.cpp runtime missing libmtmd.so in $$libdir (LLAMA_BUILD_MTMD install layout changed?)"; exit 1; }; \
			for plugin in "$(LLAMA_RUNTIME_DIR)"/bin/libggml-*.so; do [ -e "$$plugin" ] && cp "$$plugin" "$$libdir/"; done; \
			ls "$$libdir"/libggml-cpu*.so >/dev/null 2>&1 || { echo "direct llama.cpp runtime missing libggml-cpu*.so backend plugins (GGML_BACKEND_DL install layout changed?)"; exit 1; }; \
			{ [ "$(LLAMA_CUDA)" != "ON" ] || [ -f "$$libdir/libggml-cuda.so" ]; } || { echo "direct llama.cpp runtime built with CUDA but missing libggml-cuda.so in $$libdir"; exit 1; }; \
			{ [ "$(LLAMA_HIP)" != "ON" ] || [ -f "$$libdir/libggml-hip.so" ]; } || { echo "direct llama.cpp runtime built with HIP but missing libggml-hip.so in $$libdir"; exit 1; }; \
			for lib in "$$libdir"/lib*.so.*; do \
				[ -f "$$lib" ] && [ ! -L "$$lib" ] || continue; \
				soname="$$(readelf -d "$$lib" | awk -F'[][]' '/SONAME/ { print $$2; exit }')"; \
				base="$$(basename "$$lib")"; \
				if [ -n "$$soname" ] && [ "$$soname" != "$$base" ]; then ln -sf "$$base" "$$libdir/$$soname"; fi; \
			done; \
		fi; \
		{ echo 'commit=$(LLAMA_CPP_COMMIT)'; echo 'build_type=$(LLAMA_CPP_BUILD_TYPE)'; echo 'runtime_abi=$(LLAMA_RUNTIME_ABI)'; echo 'cuda=$(LLAMA_CUDA)'; echo 'hip=$(LLAMA_HIP)'; } > "$(LLAMA_RUNTIME_DIR)/.contenox-runtime-stamp"; \
		echo "direct llama.cpp runtime (cuda=$(LLAMA_CUDA) hip=$(LLAMA_HIP)) -> $(LLAMA_RUNTIME_DIR)"; \
		find "$$libdir" -maxdepth 1 \( -type f -o -type l \) -name '$(LLAMA_DSO_GLOB)' -printf '  %f\n' 2>/dev/null | sort || ls -1 "$$libdir/"$(LLAMA_DSO_NAME_GLOB) 2>/dev/null | sort || true; \
	fi

test: test-shim test-session

test-shim: runtime
	@libdir="$(LLAMA_RUNTIME_LIB_DIR)"; \
		test -f "$$libdir/libllama.so" || { echo "missing direct llama.cpp runtime; run: make build-llamacpp-runtime"; exit 1; }; \
		test -f "$$libdir/libllama-common.so" || { echo "missing direct llama.cpp common library; run: make build-llamacpp-runtime"; exit 1; }; \
		test -f "$(CONTENOX_LLAMA_TINY_GGUF)" || { echo "missing tiny test model at $(CONTENOX_LLAMA_TINY_GGUF); the model-loading shim tests would silently skip (false green). Run: make -f Makefile.llamacpp-direct deps-tiny-model"; exit 1; }; \
		CONTENOX_LLAMA_TINY_GGUF="$(CONTENOX_LLAMA_TINY_GGUF)" \
		CGO_ENABLED=1 \
		CGO_CPPFLAGS="$(LLAMA_COMMON_CPPFLAGS) $(LLAMA_DIRECT_CPPFLAGS)" \
		CGO_LDFLAGS="-L$$libdir -Wl,--disable-new-dtags -Wl,-rpath,$$libdir -Wl,-rpath-link,$$libdir -l:libllama-common.so -l:libllama.so -l:libmtmd.so -l:libggml.so -l:libggml-base.so -lstdc++ -lm -ldl -lpthread" \
		LD_LIBRARY_PATH="$$libdir$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}" \
		CONTENOX_LLAMA_BACKEND_DIR="$$libdir" \
		go test -tags 'llamacpp_direct' ./internal/modeld/llama/llamacppshim

test-session: runtime
	@libdir="$(LLAMA_RUNTIME_LIB_DIR)"; \
		test -f "$$libdir/libllama.so" || { echo "missing direct llama.cpp runtime; run: make build-llamacpp-runtime"; exit 1; }; \
		test -f "$$libdir/libllama-common.so" || { echo "missing direct llama.cpp common library; run: make build-llamacpp-runtime"; exit 1; }; \
		test -f "$(CONTENOX_LLAMA_TINY_GGUF)" || { echo "missing tiny test model at $(CONTENOX_LLAMA_TINY_GGUF); without it every llamasession system test skips (false green). Restore the in-tree model or set CONTENOX_LLAMA_TINY_GGUF."; exit 1; }; \
		CONTENOX_LLAMA_TINY_GGUF="$(CONTENOX_LLAMA_TINY_GGUF)" \
		CGO_ENABLED=1 \
		CGO_CPPFLAGS="$(LLAMA_COMMON_CPPFLAGS) $(LLAMA_DIRECT_CPPFLAGS)" \
		CGO_LDFLAGS="-L$$libdir -Wl,--disable-new-dtags -Wl,-rpath,$$libdir -Wl,-rpath-link,$$libdir -l:libllama-common.so -l:libllama.so -l:libmtmd.so -l:libggml.so -l:libggml-base.so -lstdc++ -lm -ldl -lpthread" \
		LD_LIBRARY_PATH="$$libdir$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}" \
		CONTENOX_LLAMA_BACKEND_DIR="$$libdir" \
		go test -tags 'llamanode llamacpp_direct' ./internal/modeld/llama/llamasession

test-session-vision: runtime
	@libdir="$(LLAMA_RUNTIME_LIB_DIR)"; \
		test -f "$$libdir/libllama.so" || { echo "missing direct llama.cpp runtime; run: make build-llamacpp-runtime"; exit 1; }; \
		test -e "$$libdir/libmtmd.so" || { echo "missing libmtmd.so; rebuild the runtime: make -f Makefile.llamacpp-direct runtime LLAMA_RUNTIME_REBUILD=1"; exit 1; }; \
		test -f "$(CONTENOX_LLAMA_VLM_GGUF)" || { echo "missing vision test model at $(CONTENOX_LLAMA_VLM_GGUF); without it every vision system test skips (false green). Run: make -f Makefile.llamacpp-direct deps-vlm-model"; exit 1; }; \
		test -f "$(CONTENOX_LLAMA_VLM_MMPROJ)" || { echo "missing vision test projector at $(CONTENOX_LLAMA_VLM_MMPROJ); run: make -f Makefile.llamacpp-direct deps-vlm-model"; exit 1; }; \
		CONTENOX_LLAMA_VLM_GGUF="$(CONTENOX_LLAMA_VLM_GGUF)" \
		CONTENOX_LLAMA_VLM_MMPROJ="$(CONTENOX_LLAMA_VLM_MMPROJ)" \
		CGO_ENABLED=1 \
		CGO_CPPFLAGS="$(LLAMA_COMMON_CPPFLAGS) $(LLAMA_DIRECT_CPPFLAGS)" \
		CGO_LDFLAGS="-L$$libdir -Wl,--disable-new-dtags -Wl,-rpath,$$libdir -Wl,-rpath-link,$$libdir -l:libllama-common.so -l:libllama.so -l:libmtmd.so -l:libggml.so -l:libggml-base.so -lstdc++ -lm -ldl -lpthread" \
		LD_LIBRARY_PATH="$$libdir$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}" \
		CONTENOX_LLAMA_BACKEND_DIR="$$libdir" \
		go test -tags 'llamanode llamacpp_direct' -timeout 20m -run 'Vision' ./internal/modeld/llama/llamasession

clean:
	rm -rf "$(LLAMA_CPP_BUILD_ROOT)" "$(LLAMA_RUNTIME_ROOT)"
