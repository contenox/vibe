---
import Base from '../../layouts/Base.astro';
import Landing from '../../components/Landing.astro';
import type { LandingStrings } from '../../components/Landing.astro';

const t: LandingStrings = {
  badge: 'Missionen statt Sessions',
  h1a: 'Mission abfeuern.',
  h1b: 'Fertig vorfinden.',
  lede: 'Feuere Arbeit auf einen Agenten ab — unter einem Envelope, den du geschrieben hast. Häng dich aus. Unterbrochen wirst du nur, wenn der Envelope es sagt. Oder lass es headless über eine Aufgabenliste laufen, Zeile für Zeile, jede in sauberem Kontext.',
  ctaRecipe: 'Rezept ausführen',
  ctaPackage: 'Workflow verpacken',
  ctaGithub: 'Auf GitHub ansehen',
  installNote: 'Installiert <code class="font-mono">contenox</code>. Mit <code class="font-mono">contenox init</code> richtest du einen Workspace ein.',
  positioning: 'contenox ist ein offenes Coding-Harness: dieselben Sessions im Terminal und im Editor, jede Regel eine lesbare Datei, jedes Modell und jeder MCP in Kombination.',
  tableWorld: 'Der alte Weg',
  tableWhy: 'contenox',
  rows: [
    ['Ein versteckter Prompt', 'Eine Datei, die du editierst'],
    ['Blast-Radius raten', 'Ein Envelope, den du geschrieben hast'],
    ['Zuschauen, wie es arbeitet', 'Ausgehängte Missionen'],
    ['Ein Anbieter', 'Jedes Modell, jeder MCP — kombiniert'],
  ],
  authorEyebrow: 'Was du bauen kannst',
  authorH2: 'Wiederholbare Arbeit, mit Policy in der Datei.',
  authorItems: [
    'Release-Evidenzpaket: Git-Historie, PRs, Ticketnotizen und CI-Ausgaben rein; die Chain entwirft Changelog, Risikohinweise und Deployment-Checkliste — und stoppt vor der Veröffentlichung.',
    'API-zu-Workflow-Wrapper: ein schmales OpenAPI-Subset registrieren, versteckte Workspace- oder Umgebungsargumente injizieren und Freigaben für schreibende Aufrufe verlangen.',
    'Repo-Wartungs-Chain: ein Issue analysieren, den Patch planen, nur freigegebene Dateien anfassen, Tests ausführen und ein Review-Paket vorbereiten, statt das Projekt still zu verändern.',
    'Browser-QA-Evidenz: Playwright erfasst den Live-Zustand der App, die Chain schreibt Doku oder Screenshots, und die Policy entscheidet, was menschliche Freigabe braucht.',
  ],
  editorsEyebrow: 'Dort, wo gearbeitet wird',
  editorsH2: 'Dieselbe Chain läuft im Editor, im Terminal oder in der Automatisierung.',
  editorsLede: 'Contenox spricht das Agent Client Protocol über stdio. Nutze Zed, JetBrains, AionUi oder OpenClaw, wenn eine Editor-Oberfläche hilft; der Workflow selbst bleibt in der Chain-Datei, Tool-Aufrufe und HITL-Freigaben laufen über den Client.',
  guides: [
    ['Zed-Anleitung lesen', '/docs/integrations/editors/zed/'],
    ['JetBrains-Anleitung lesen', '/docs/integrations/editors/jetbrains/'],
    ['AionUi-Anleitung lesen', '/docs/integrations/editors/aionui/'],
    ['OpenClaw-Anleitung lesen', '/docs/integrations/editors/openclaw/'],
  ],
  capsEyebrow: 'Kernfähigkeiten',
  caps: [
    ['Die Chain ist der Vertrag', 'Prompts, Modell-Routing, Tool-Allowlists, Kommando-Policies, Budgets und Freigabe-Gates sind sichtbare Schlüssel in einer versionierten Datei — prüfbar, diffbar, wiederholbar.'],
    ['Läuft, wo gearbeitet wird', 'Ein Harness hinter dem CLI, der beam-TUI und jedem ACP-Editor. Dieselben Chains, Sessions und Policies überall.'],
    ['Provider sind Konfiguration', 'Inferenz läuft über lokales Ollama oder vLLM — oder über OpenAI, Anthropic, Gemini, Bedrock oder Vertex — ohne den Workflow anzufassen.'],
    ['Lokal als Standard', 'Sessions, Konfiguration, Run-Logs und Zustand liegen in SQLite auf deinem Rechner. Kein gehosteter Dienst, kein Konto — Telemetrie ist opt-in und standardmäßig aus.'],
  ],
  hitlDemoAlt: 'Terminal-Demo: Ein destruktives rm-Kommando stoppt vor der Ausführung an einem Freigabe-Gate',
  tuiShotAlt: 'contenox beam im Terminal: eine Aufgabe in natürlicher Sprache, contenox liest das Repo und antwortet in derselben Session',
  tuiEyebrow: 'Die Terminal-UI',
  tuiH2: 'Eine Session. Chat, Plan, Shell.',
  tuiLede: 'contenox beam öffnet eine persistente Terminal-Session, in der Unterhaltung, Pläne und Shell-Kommandos einen Kontext teilen — und MCP-Tool-Verbindungen über die Turns hinweg offen bleiben, statt sich bei jedem Aufruf neu zu verbinden.',
  tuiPoints: [
    ['Chatten, planen und ausführen an einem Ort', 'Das Problem besprechen, den Plan skizzieren, die Kommandos ausführen — ohne Fensterwechsel und ohne Kontextverlust zwischen den Modi.'],
    ['MCP bleibt warm', 'Tool-Server verbinden sich einmal und bleiben über die Turns hinweg verbunden — zustandsbehaftete Tools behalten ihren Zustand, und Antworten kommen schnell.'],
    ['Freigaben, die nicht im Weg stehen', 'Riskante Schritte pausieren für ein kurzes Ja oder Nein direkt in der Session — sinnvolle Defaults, kein Zeremoniell.'],
  ],
  tuiCta: 'Das contenox CLI entdecken',
  standardsEyebrow: 'Auf offenen Standards gebaut',
  standardsH2: 'Spricht die Protokolle, die deine Tools schon nutzen.',
  standards: [
    ['Agent Client Protocol', 'Der komplette Agent in Zed, JetBrains, AionUi und jedem ACP-Client — über stdio, ohne Plugin-Lock-in.', 'https://agentclientprotocol.com'],
    ['Model Context Protocol', 'Registriere jeden MCP-Server — stdio, SSE oder HTTP — und seine Tools werden policy-begrenzte Chain-Tools.', 'https://modelcontextprotocol.io'],
    ['OpenAPI', 'Zeige auf einen HTTP-Dienst mit Spec, und jede Operation wird ein aufrufbares, allowlistbares Tool.', '/docs/integrations/tools/remote/'],
  ],
  bottomEyebrow: 'Loslegen',
  bottomH2: 'Feuere deine erste Mission ab.',
  bottomCta: 'Quickstart lesen',
  bottomContact: 'Fragen? <a href="mailto:hello@contenox.com" class="underline hover:text-black dark:hover:text-white">hello@contenox.com</a> · Issues und PRs auf <a href="https://github.com/contenox/beam" class="underline hover:text-black dark:hover:text-white">GitHub</a>',
  builtOnEyebrow: 'Baut auf',
  builtOnNote: 'Lokale Modelle laufen über Ollama oder vLLM und deren lokale APIs; gehostete Provider über ihre öffentlichen APIs. Keine mitgelieferte Inferenz-Runtime, keine GPU-Treiber im Paket.',
  builtOn: [
    ['Go', 'die Implementierung', 'https://go.dev'],
    ['SQLite', 'lokaler Zustand', 'https://sqlite.org'],
    ['Ollama', 'lokale Modelle', 'https://ollama.com'],
    ['vLLM', 'lokale Modelle', 'https://github.com/vllm-project/vllm'],
  ],
};
---
<Base
  title="Contenox - Ein offenes Coding-Harness für Terminal und ACP-Editoren"
  description="Contenox — ein offenes Coding-Harness. Chat, Missionen und Tools im Terminal, in der beam-TUI oder jedem ACP-Editor, mit den Modellen deiner Wahl."
  lang="de"
  alternates={{ en: '/', de: '/de/' }}
>
  <Landing t={t} />
</Base>
