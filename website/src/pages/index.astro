---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import type { LandingStrings } from '../components/Landing.astro';

const rulesCode = `{
  "default_action": "approve",
  "compute": { "maxToolCalls": 300, "maxTokens": 2000000, "onExhausted": "finish_stuck" },
  "rules": [
    { "tools": "local_fs", "tool": "*", "action": "deny",
      "when": [{ "key": "path", "op": "glob",
                 "value": "**/{.ssh,.aws,.kube,.config/gcloud}/**" }] },
    { "tools": "local_fs", "tool": "read_file", "action": "allow" },
    { "tools": "local_fs", "tool": "write_file", "action": "approve" },
    { "tools": "local_shell", "tool": "local_shell", "action": "allow",
      "when": [{ "key": "command", "op": "command_prefix_allowlist",
                 "value": "go test,go vet,ls,cat,grep,npm test,pytest" }] },
    { "tools": "local_shell", "tool": "local_shell", "action": "approve" }
  ],
  "attention": { "allowAgentAnswers": false }
}`;

const routeCode = `{
  "id": "classify_request",
  "handler": "route",
  "system_instruction": "Classify the user's latest message. Use 'coding_change'
    for requests to create, edit, refactor, fix, test or otherwise change
    code/files. Use 'general' for questions, explanations, setup help. Use
    'review_change' for requests to review, audit or assess code that already
    exists, where nothing is to be modified...",
  "execute_config": { "model": "{{var:alt_model|var:model}}", "tools": [] },
  "transition": {
    "on_failure": "acp_chat",
    "branches": [
      { "operator": "equals",  "when": "coding_change", "goto": "coding_chat" },
      { "operator": "equals",  "when": "general",       "goto": "acp_chat" },
      { "operator": "equals",  "when": "review_change", "goto": "review_chat" },
      { "operator": "default", "when": "",              "goto": "acp_chat" }
    ]
  }
}`;

const t: LandingStrings = {
  badge: 'Missions, not sessions',
  h1a: 'Fire the mission.',
  h1b: 'Come back to done.',
  lede: 'Fire work at an agent under an envelope you wrote. Detach. It interrupts you only when the envelope says so. Or run it headless over a task list, one line at a time, each item in a clean context.',
  ctaRecipe: 'Run a recipe',
  copyLabel: 'Copy',
  ctaGithub: 'View on GitHub',
  installNote: 'Installs <code class="font-mono">contenox</code>. Run <code class="font-mono">contenox init</code> to scaffold a workspace.',
  trustChips: ['any model', 'one binary', 'no account', 'SQLite', 'your rules in a file you can read'],

  missionEyebrow: 'The mission, live',
  missionH2: 'Thirty seconds, end to end.',
  missionLede: 'One command fires a declared agent at a task, bounded by a policy you wrote. What happens after you walk away is the point.',
  missionLines: [
    ['note', '# fire a mission under a strict envelope'],
    ['cmd', 'contenox mission fire agent-reviewer "review the payment-retry PR for regressions" --wait'],
    ['out', 'mission fired · envelope hitl-policy-strict.json'],
    ['out', 'unit reads the diff, runs the tests — allowed rules pass silently'],
    ['out', '⏸ the agent asks: two regressions found, patch drafted — apply it to the branch?'],
    ['out', 'no answer: run checkpointed, ask saved, process released'],
    ['note', '# close the laptop. days pass. then, from any terminal that reaches your models:'],
    ['cmd', 'contenox approvals list'],
    ['out', 'ask 8f3c · apply the drafted patch? · mission 01jm…'],
    ['cmd', 'contenox approvals respond 8f3c --answer "yes, apply it"'],
    ['out', 'checkpoint resumed — exactly once. mission landed.'],
    ['cmd', 'contenox inbox list'],
    ['out', 'report · agent-reviewer: findings, patch applied, test results — waiting for you'],
  ],
  missionOutro: 'No babysitting a terminal, no timed-out approvals, no silent changes. The envelope decided what could run unattended, the chain decided where a human gets the final word, and one answer resumed the run exactly once.',
  missionCta: ['How missions, approvals, and the inbox work', '/docs/reference/contenox-cli/#contenox-mission'],

  panelEyebrow: 'The part you can’t download',
  panelH2: 'You’ve already used this engine. You’ve just never held the controls.',
  panelP1: 'When an assistant shows you its "thinking steps," you’re watching an orchestration loop: plan, call a tool, check the result, check the budget, decide again. Every major AI product runs on one — event-driven agent choreography under governance. That layer decides what the model may do, when it pauses, and what it costs. The vendor configures it. You never see it, and you can’t change it.',
  panelP2: 'Contenox is that layer, shipped as the product — with the control panel handed to the operator. The loop is a chain file you author. The boundaries are an envelope you wrote. The state is on your disk. The differentiator isn’t inventing the machine; it’s who holds the controls.',

  routeEyebrow: 'Chain → workflow → agent loop',
  routeH2: 'One sentence in. The loop that sentence deserves.',
  routeLede: 'A chain does not begin with an agent. It begins with a route task that reads the request, labels it, and hands it to the loop built for that label — its own instruction, its own tool scope, its own budget, its own recovery path. The interactive chains that ship with contenox sort every message into coding_change, general, or review_change before anything else runs.',
  routeCode,
  routeOutro: 'Trimmed from the shipped chain-agent-acp.json. The classifier holds no tools, so it cannot act on a request it has not yet understood, and it can run on a cheaper model than the loops it feeds. An unrecognised label falls to the default branch — the least-powerful loop, never the most. Which branch ran is in the run log, so a disappointing answer is a question with an answer.',
  routeDomains: [
    'A specialist is configuration, not phrasing: the review loop withholds every mutating tool with hide_tools, enforced where calls execute rather than by leaving them out of what the model was offered.',
    'A support assistant routes billing questions to a read-only loop with the billing API, and account changes to one that can write but pauses for a human.',
    'A data workflow routes "summarise this" and "extract these fields" to loops with different output contracts, so callers get parseable output without asking for it every time.',
    'A governed deployment routes anything touching regulated data to a loop under a stricter policy, no matter how the request was phrased.',
  ],
  routeCtas: [
    ['How request routing works', '/docs/guide/request-routing/'],
    ['The story: a review branch, with the write tools taken away', '/docs/use-cases/review-specialist/'],
  ],

  rulesEyebrow: 'You write the rules',
  rulesH2: 'How much agency? You decide — in writing.',
  rulesLede: 'Every run is bounded by an envelope: a JSON policy naming what passes silently, what pauses for a human, and what is denied outright — plus hard ceilings on tool calls and tokens, and a pin on which models and backends the unit may use. No hidden prompt decides for you. The file lives in your repo and gets reviewed like any other change.',
  rulesCode,
  rulesOutro: 'Trimmed from the shipped default preset. Anything no rule matches fails closed — it asks a human. Six presets ship with contenox init, and contenox vet checks your policy before anything runs under it.',
  rulesCta: ['The full policy format', '/docs/guide/hitl/'],
  hitlDemoAlt: 'Terminal demo: a destructive rm command stops at a human approval gate before it runs',

  craftEyebrow: 'Agentic engineering',
  craftH2: 'Vibecoding finds the loop. Loop engineering keeps it.',
  craftP1: 'Vibecoding is real discovery — improvising with an agent until the loop works. We’ve shipped features that way and written honestly about what it cost. But a loop that has to run tomorrow, in CI, unattended, isn’t a vibe anymore. It’s an artifact.',
  craftP2: 'That’s agentic engineering: the loop is authored, reviewed, versioned, and bounded — and so is the choice of which loop runs. Every stage in a contenox chain came from a named failure mode, under one discipline: never let confusion default into unattended mutation.',

  everyEyebrow: 'One harness, everywhere',
  everyH2: 'Author once. Run it where the work is.',
  everyLede: 'The same agentic workflow, the same envelope, the same session state behind every surface — what you approved in the editor is what runs from cron.',
  surfaces: [
    ['Your terminal', 'contenox new opens a fresh session for chat, plan, and shell; contenox resume reopens the last one with its transcript. Stateful tools keep their state across turns, and an approval is a one-keypress card in the transcript.'],
    ['Your editor', 'The full agent inside Zed, JetBrains, AionUi, or OpenClaw — approvals route through the editor’s own UI, and the workflow stays in the chain file, not the plugin.'],
    ['Your scripts and pipelines', 'contenox run executes a chain non-interactively — from cron, CI, or a shell script. Tool-heavy jobs are the home ground: release evidence packs, request-processing chains, narrow API wrappers with approval on every mutating call.'],
    ['Untrusted drivers', 'A headless acpx session gets the hardened profile: shell, writes, and network are denied outright rather than offered for approval.'],
  ],
  protocols: [
    ['Editors talk to the full agent over stdio — no plugin lock-in.', 'Agent Client Protocol', 'https://agentclientprotocol.com'],
    ['Any MCP server — stdio, SSE, or HTTP — registers once; its tools become policy-scoped chain tools.', 'Model Context Protocol', 'https://modelcontextprotocol.io'],
    ['Any HTTP service with a spec becomes a callable, allowlistable tool.', 'OpenAPI tools guide', '/docs/integrations/tools/remote/'],
  ],
  guides: [
    ['Read the Zed guide', '/docs/integrations/editors/zed/'],
    ['Read the JetBrains guide', '/docs/integrations/editors/jetbrains/'],
    ['Read the AionUi guide', '/docs/integrations/editors/aionui/'],
    ['Read the OpenClaw guide', '/docs/integrations/editors/openclaw/'],
  ],
  tuiShotAlt: 'contenox new in the terminal: a natural-language task, contenox reads the repo and answers in the same session',

  seatEyebrow: 'The same seat, contested',
  seatH2: 'Copilot helps you type. Contenox does the shift while you’re gone.',
  seatP1: 'The AI that does work for you at work is one seat, and there are two ways to fill it. The vendor’s agent runs on your work: behavior decided in Redmond, rules you can’t read, tenant-admin-controlled, your usage flowing into their telemetry.',
  seatP2: 'Contenox is the other way to fill it: your agent under your envelope — rules you wrote, state on your disk, models you chose. Not two categories. One category, contested from opposite ends.',

  yoursEyebrow: 'Yours by default',
  yoursH2: 'Your machine, your state, your models.',
  yoursPoints: [
    'Sessions, config, run logs, and captured execution state live in SQLite on your machine. No hosted service, no account — telemetry is opt-in and off by default.',
    'Inference is configuration: local Ollama or vLLM when nothing may leave your network, or OpenAI, Anthropic, Gemini, Bedrock, and Vertex on your own keys, pinned to a region you choose. Swapping later is a config change, not a rewrite.',
    'Secrets resolve from your environment at request time and never land in config on disk; agent-reachable shells get a scrubbed environment with only what the task needs.',
  ],
  yoursCta: ['AI sovereignty & the EU AI Act', '/docs/guide/sovereignty/'],

  capsEyebrow: 'Also in the box',
  caps: [
    ['It reads Go like the compiler', 'Definition, references, implementations, symbols, diagnostics — answered in-process by the real type-checker, warm in microseconds. No language server to install or babysit.'],
    ['Ask the repo, get cited lines', 'contenox index builds a hybrid full-text and embedding index in local SQLite; contenox search answers with file:line citations and marks a hit stale the moment its file changes.'],
  ],

  bottomEyebrow: 'Get started',
  bottomH2: 'Fire your first mission.',
  bottomCta: 'Read the Quickstart',
  bottomContact: 'Questions? <a href="mailto:hello@contenox.com" class="underline hover:text-black dark:hover:text-white">hello@contenox.com</a> · Issues and PRs on <a href="https://github.com/contenox/contenox" class="underline hover:text-black dark:hover:text-white">GitHub</a>',
  builtOnEyebrow: 'Built on',
  builtOnNote: 'Local models connect through Ollama or vLLM over their local APIs; hosted providers over their public APIs. No bundled inference runtime, no GPU drivers to ship.',
  builtOn: [
    ['Go', 'the implementation', 'https://go.dev'],
    ['SQLite', 'local state', 'https://sqlite.org'],
    ['Ollama', 'local models', 'https://ollama.com'],
    ['vLLM', 'local models', 'https://github.com/vllm-project/vllm'],
  ],
};
---
<Base
  title="Contenox — Fire the mission. Come back to done."
  description="Fire work at an agent under rules you can read. A chain routes each request to the specialist loop built for it. Detach, answer later from any terminal that reaches your models, and it resumes exactly once — any model, any MCP, no account."
  alternates={{ en: '/', de: '/de/' }}
>
  <Landing t={t} />
</Base>
