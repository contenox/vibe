---
export interface LandingStrings {
  h1a: string;
  h1b: string;
  lede: string;
  ctaRecipe: string;
  ctaGithub: string;
  copyLabel: string;
  /** OS tab labels on the install command. */
  installTabPosix: string;
  installTabWindows: string;
  installNote: string;
  trustChips: string[];
  missionEyebrow: string;
  missionH2: string;
  missionLede: string;
  /** [kind, text] — kind is 'cmd' (operator input), 'out' (runtime output), or 'note' (narrative comment). */
  missionLines: [string, string][];
  missionOutro: string;
  missionCta: [string, string];
  panelEyebrow: string;
  panelH2: string;
  panelP1: string;
  panelP2: string;
  routeEyebrow: string;
  routeH2: string;
  routeLede: string;
  routeCode: string;
  routeOutro: string;
  /** One line per domain the same router shape serves. */
  routeDomains: string[];
  /** [label, href] — reading paths out of the routing section. */
  routeCtas: [string, string][];
  rulesEyebrow: string;
  rulesH2: string;
  rulesLede: string;
  rulesCode: string;
  rulesOutro: string;
  rulesCta: [string, string];
  hitlDemoAlt: string;
  craftEyebrow: string;
  craftH2: string;
  craftP1: string;
  craftP2: string;
  everyEyebrow: string;
  everyH2: string;
  everyLede: string;
  surfaces: [string, string][];
  /** [line text, link label, href] — one supporting line per protocol. */
  protocols: [string, string, string][];
  guides: [string, string][];
  tuiShotAlt: string;
  seatEyebrow: string;
  seatH2: string;
  seatP1: string;
  seatP2: string;
  yoursEyebrow: string;
  yoursH2: string;
  yoursPoints: string[];
  yoursCta: [string, string];
  relayEyebrow: string;
  relayH2: string;
  relayP: string;
  relayCta: [string, string];
  /** [line text, link label, href] — one muted line under the relay CTA: the managed option, ending in the contact link. */
  relayNote: [string, string, string];
  capsEyebrow: string;
  caps: [string, string][];
  bottomEyebrow: string;
  bottomH2: string;
  bottomCta: string;
  bottomContact: string;
  builtOnEyebrow: string;
  builtOnNote: string;
  builtOn: [string, string, string][];
}
interface Props {
  t: LandingStrings;
}
import InstallCommand from './InstallCommand.astro';
const { t } = Astro.props;
// Large media (gifs, screenshots) is served from the website's S3 bucket.
const media = 'https://contenox-website-assets-573643652148.s3.amazonaws.com/media/';
const card = 'rounded-xl border border-neutral-200/60 bg-white/80 p-5 shadow-sm backdrop-blur-sm transition-all hover:-translate-y-1 hover:border-primary-500/30 hover:shadow-lg hover:shadow-primary-500/10 dark:border-neutral-800/60 dark:bg-neutral-950/80 dark:hover:border-primary-400/30';
const btnGhost = 'rounded-lg border border-neutral-200 px-4 py-2 text-sm font-semibold transition-all hover:bg-neutral-50 hover:shadow-sm dark:border-neutral-800 dark:hover:bg-neutral-900';
const ctaLink = 'font-semibold text-primary-700 hover:text-primary-600 dark:text-primary-400 dark:hover:text-primary-300';
---
<section class="hero-grid border-b border-neutral-200 px-5 py-20 text-center dark:border-neutral-800">
  <h1 class="mx-auto max-w-3xl bg-gradient-to-br from-neutral-900 to-neutral-500 bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl dark:from-white dark:to-neutral-500">
    {t.h1a}
    <span class="text-neutral-500 dark:text-neutral-400">{t.h1b}</span>
  </h1>
  <p class="mx-auto mt-6 max-w-xl text-neutral-600 dark:text-neutral-400">{t.lede}</p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a href="/docs/use-cases/" class="rounded-lg bg-gradient-to-r from-primary-500 to-primary-700 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-primary-500/20 transition-all hover:scale-105 hover:shadow-primary-500/40">{t.ctaRecipe}</a>
    <a href="https://github.com/contenox/contenox" class={btnGhost}>{t.ctaGithub}</a>
  </div>
  <div class="mt-10">
    <InstallCommand posixLabel={t.installTabPosix} windowsLabel={t.installTabWindows} copyLabel={t.copyLabel} />
  </div>
  <p class="mt-3 text-xs text-neutral-500" set:html={t.installNote} />
  <div class="mx-auto mt-4 flex max-w-lg flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-neutral-500 dark:text-neutral-500">
    {t.trustChips.map((chip, i) => (
      <>
        {i > 0 && <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">&middot;</span>}
        <span>{chip}</span>
      </>
    ))}
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
    <a href="https://github.com/contenox/contenox"><img src="https://img.shields.io/github/stars/contenox/contenox?style=flat&logo=github&color=444" alt="GitHub stars" loading="lazy" /></a>
    <a href="https://github.com/contenox/contenox/releases"><img src="https://img.shields.io/github/v/release/contenox/contenox?label=version&color=444" alt="Latest release" loading="lazy" /></a>
    <img src="https://img.shields.io/badge/License-Apache%202.0-444" alt="Apache-2.0" loading="lazy" />
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.missionEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.missionH2}</h2>
  <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600 dark:text-neutral-400">{t.missionLede}</p>
  <div class="mx-auto mt-8 max-w-3xl overflow-x-auto rounded-xl border border-neutral-200/60 bg-white/60 p-5 text-left font-mono text-sm leading-7 shadow-lg backdrop-blur-md dark:border-neutral-800/60 dark:bg-neutral-950/70">
    {t.missionLines.map(([kind, text]) => (
      kind === 'cmd' ? (
        <div class="whitespace-nowrap text-neutral-800 dark:text-neutral-100"><span class="mr-2 select-none text-neutral-400 dark:text-neutral-500">$</span>{text}</div>
      ) : kind === 'note' ? (
        <div class="whitespace-nowrap text-neutral-400 italic dark:text-neutral-500">{text}</div>
      ) : (
        <div class="whitespace-nowrap pl-5 text-neutral-500 dark:text-neutral-400">{text}</div>
      )
    ))}
  </div>
  <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600 dark:text-neutral-400">{t.missionOutro}</p>
  <div class="mt-6 text-center text-sm">
    <a href={t.missionCta[1]} class={ctaLink}>{t.missionCta[0]} →</a>
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.panelEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.panelH2}</h2>
  <div class="mx-auto mt-6 max-w-2xl space-y-4 text-neutral-600 dark:text-neutral-400">
    <p>{t.panelP1}</p>
    <p>{t.panelP2}</p>
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.routeEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.routeH2}</h2>
  <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600 dark:text-neutral-400">{t.routeLede}</p>
  <div class="mx-auto mt-8 max-w-3xl overflow-x-auto rounded-xl border border-neutral-200/60 bg-white/60 p-5 text-left font-mono text-xs leading-6 text-neutral-700 shadow-sm backdrop-blur-md sm:text-sm dark:border-neutral-800/60 dark:bg-neutral-950/60 dark:text-neutral-300">
    <pre class="m-0">{t.routeCode}</pre>
  </div>
  <p class="mx-auto mt-4 max-w-2xl text-center text-sm text-neutral-500">{t.routeOutro}</p>
  <ul class="mx-auto mt-8 max-w-2xl space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
    {t.routeDomains.map((line) => (
      <li class="flex gap-3"><span class="text-neutral-400 dark:text-neutral-600">→</span><span>{line}</span></li>
    ))}
  </ul>
  <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
    {t.routeCtas.map(([label, href]) => (
      <a href={href} class={ctaLink}>{label} →</a>
    ))}
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.rulesEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.rulesH2}</h2>
  <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600 dark:text-neutral-400">{t.rulesLede}</p>
  <div class="mx-auto mt-8 max-w-3xl overflow-x-auto rounded-xl border border-neutral-200/60 bg-white/60 p-5 text-left font-mono text-xs leading-6 text-neutral-700 shadow-sm backdrop-blur-md sm:text-sm dark:border-neutral-800/60 dark:bg-neutral-950/60 dark:text-neutral-300">
    <pre class="m-0">{t.rulesCode}</pre>
  </div>
  <p class="mx-auto mt-4 max-w-2xl text-center text-sm text-neutral-500">{t.rulesOutro}</p>
  <img
    src={`${media}hitl-approve.gif`}
    alt={t.hitlDemoAlt}
    loading="lazy"
    class="mx-auto mt-8 w-full max-w-3xl rounded-xl border border-neutral-200/60 shadow-lg dark:border-neutral-800/60"
  />
  <div class="mt-6 text-center text-sm">
    <a href={t.rulesCta[1]} class={ctaLink}>{t.rulesCta[0]} →</a>
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.craftEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.craftH2}</h2>
  <div class="mx-auto mt-6 max-w-2xl space-y-4 text-neutral-600 dark:text-neutral-400">
    <p>{t.craftP1}</p>
    <p>{t.craftP2}</p>
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.everyEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.everyH2}</h2>
  <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600 dark:text-neutral-400">{t.everyLede}</p>
  <div class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-2">
    {t.surfaces.map(([title, body]) => (
      <div class={card}>
        <h3 class="font-semibold">{title}</h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{body}</p>
      </div>
    ))}
  </div>
  <img
    src={`${media}hero.gif`}
    alt={t.tuiShotAlt}
    loading="lazy"
    class="mx-auto mt-8 w-full max-w-3xl rounded-xl border border-neutral-200/60 shadow-lg dark:border-neutral-800/60"
  />
  <ul class="mx-auto mt-8 max-w-2xl space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
    {t.protocols.map(([line, label, href]) => (
      <li class="flex gap-3">
        <span class="text-neutral-400 dark:text-neutral-600">→</span>
        <span>{line} <a href={href} class="text-neutral-700 underline decoration-neutral-300 underline-offset-2 hover:text-black dark:text-neutral-300 dark:decoration-neutral-700 dark:hover:text-white">{label}</a></span>
      </li>
    ))}
  </ul>
  <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
    {t.guides.map(([label, href]) => (
      <a href={href} class="text-neutral-600 hover:text-black dark:text-neutral-400 dark:hover:text-white">{label} →</a>
    ))}
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.seatEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.seatH2}</h2>
  <div class="mx-auto mt-6 max-w-2xl space-y-4 text-neutral-600 dark:text-neutral-400">
    <p>{t.seatP1}</p>
    <p>{t.seatP2}</p>
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.yoursEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.yoursH2}</h2>
  <ul class="mx-auto mt-8 max-w-2xl space-y-4 text-neutral-600 dark:text-neutral-400">
    {t.yoursPoints.map((item) => (
      <li class="flex gap-3"><span class="text-neutral-400 dark:text-neutral-600">→</span><span>{item}</span></li>
    ))}
  </ul>
  <div class="mt-6 text-center text-sm">
    <a href={t.yoursCta[1]} class={ctaLink}>{t.yoursCta[0]} →</a>
  </div>
</section>

<section class="border-b border-neutral-200 px-5 py-16 dark:border-neutral-800">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.relayEyebrow}</p>
  <h2 class="mt-2 text-center text-2xl font-bold tracking-tight sm:text-3xl">{t.relayH2}</h2>
  <p class="mx-auto mt-6 max-w-2xl text-center text-neutral-600 dark:text-neutral-400">{t.relayP}</p>
  <div class="mt-6 text-center text-sm">
    <a href={t.relayCta[1]} class={ctaLink}>{t.relayCta[0]} →</a>
  </div>
  <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-neutral-500">
    {t.relayNote[0]} <a href={t.relayNote[2]} class="underline hover:text-black dark:hover:text-white">{t.relayNote[1]}</a>.
  </p>
</section>

<section class="px-5 py-16">
  <p class="text-center text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.capsEyebrow}</p>
  <div class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-2">
    {t.caps.map(([title, body]) => (
      <div class={card}>
        <h3 class="font-semibold">{title}</h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{body}</p>
      </div>
    ))}
  </div>
</section>

<section class="hero-grid border-t border-neutral-200 px-5 py-16 text-center dark:border-neutral-800">
  <p class="text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.bottomEyebrow}</p>
  <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{t.bottomH2}</h2>
  <div class="mt-8">
    <InstallCommand posixLabel={t.installTabPosix} windowsLabel={t.installTabWindows} copyLabel={t.copyLabel} />
  </div>
  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <a href="/docs/guide/quickstart/" class="rounded-lg bg-gradient-to-r from-primary-500 to-primary-700 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-primary-500/20 transition-all hover:scale-105 hover:shadow-primary-500/40">{t.bottomCta}</a>
  </div>
  <p class="mt-6 text-sm text-neutral-500" set:html={t.bottomContact} />

  <p class="mt-14 text-xs font-semibold tracking-widest text-neutral-500 uppercase">{t.builtOnEyebrow}</p>
  <div class="mx-auto mt-4 flex max-w-3xl flex-wrap items-baseline justify-center gap-x-8 gap-y-3">
    {t.builtOn.map(([name, role, href]) => (
      <a href={href} rel="noopener noreferrer" class="group text-sm no-underline">
        <span class="font-semibold text-neutral-700 group-hover:text-black dark:text-neutral-300 dark:group-hover:text-white">{name}</span>
        <span class="ml-1.5 text-neutral-500">{role}</span>
      </a>
    ))}
  </div>
  <p class="mx-auto mt-4 max-w-2xl text-center text-xs text-neutral-500">{t.builtOnNote}</p>

  <div class="mt-20 flex justify-center pointer-events-none select-none overflow-hidden">
    <img src="/logo-wide-colored-light.svg" alt="" aria-hidden="true" class="w-full max-w-5xl opacity-40 dark:hidden" />
    <img src="/logo-wide-colored-dark.svg" alt="" aria-hidden="true" class="hidden w-full max-w-5xl opacity-40 dark:block" />
  </div>
</section>
